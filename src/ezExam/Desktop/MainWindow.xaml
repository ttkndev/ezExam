<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ezExam - Quản lý kỳ thi"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <DockPanel>
        <!-- Sidebar -->
        <StackPanel DockPanel.Dock="Left" Width="220" Background="#2C3E50">
            <TextBlock Text="ezExam" Foreground="White" FontSize="22"
                       FontWeight="Bold" Margin="10"/>
            <Button Content="Kỳ thi" Command="{Binding ShowKyThiCommand}" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Thí sinh" Command="{Binding ShowThiSinhCommand}" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Xếp phòng" Command="{Binding ShowPhongThiCommand}" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Xuất file" Command="{Binding ShowExportCommand}" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Cài đặt" Command="{Binding ShowAboutCommand}" Style="{StaticResource NavButtonStyle}"/>
        </StackPanel>

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Background="#ECECEC" Height="30">
            <TextBlock Text="ezExam v1.0.0 © 2026 Thịnh – Liên hệ: thinh@example.com"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="12" Foreground="#555"/>
        </Grid>

        <!-- Content -->
        <Grid Background="White">
            <ContentControl Content="{Binding CurrentView}" />
        </Grid>
    </DockPanel>
</Window>
