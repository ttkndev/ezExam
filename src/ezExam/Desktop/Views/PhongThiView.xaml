<UserControl x:Class="Desktop.Views.PhongThiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Thêm phòng thi" Command="{Binding AddPhongThiCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding PhongThis}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên phòng" Binding="{Binding TenPhong}" Width="150"/>
                <DataGridTextColumn Header="Sức chứa" Binding="{Binding SucChua}" Width="100"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
