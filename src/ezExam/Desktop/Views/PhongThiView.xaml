<UserControl x:Class="Desktop.Views.PhongThiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding KyThiMacDinhText}" FontWeight="Bold" FontSize="14" Foreground="DarkBlue" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Sức chứa/phòng:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding RoomCapacity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
            <TextBlock Text="Chiến lược:" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" Width="180"/>
            <TextBlock Text="Môn/Ca xem phòng:" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <ComboBox ItemsSource="{Binding AvailableSubjects}" SelectedItem="{Binding SelectedSubject}" Width="150"/>
            <Button Content="Tải thống kê" Command="{Binding LoadSubjectStatsCommand}" Width="100" Margin="12,0,0,0"/>
            <Button Content="Xếp phòng" Command="{Binding AllocateCommand}" Width="100" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="{Binding SubjectCountVan, StringFormat=Văn: {0}}" Margin="0,0,16,0"/>
            <Label Content="{Binding SubjectCountToan, StringFormat=Toán: {0}}" Margin="0,0,16,0"/>
            <Label Content="{Binding SubjectCountCa1, StringFormat=Ca 1: {0}}" Margin="0,0,16,0"/>
            <Label Content="{Binding SubjectCountCa2, StringFormat=Ca 2: {0}}" Margin="0,0,16,0"/>
            <Label Content="{Binding TotalRooms, StringFormat=Tổng phòng: {0}}" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Danh sách phòng" Grid.Column="0" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding FilteredRoomRows}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="60"/>
                        <DataGridTextColumn Header="Môn" Binding="{Binding SubjectsSummary}" Width="*"/>
                        <DataGridTextColumn Header="Sĩ số" Binding="{Binding OccupancyText}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Thí sinh chi tiết theo phòng" Grid.Column="1" Margin="8,0,0,0">
                <DataGrid ItemsSource="{Binding CandidateRoomEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="60"/>
                        <DataGridTextColumn Header="Môn" Binding="{Binding Subject}" Width="120"/>
                        <DataGridTextColumn Header="SBD" Binding="{Binding Sbd}" Width="100"/>
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/>
                        <DataGridTextColumn Header="Lớp" Binding="{Binding Lop}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
