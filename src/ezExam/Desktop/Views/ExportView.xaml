<UserControl x:Class="Desktop.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <Button Content="Xuất thẻ dự thi" Command="{Binding ExportTheCommand}" Style="{StaticResource ToolbarButtonStyle}" Height="50"/>
            <Button Content="Xuất danh sách phòng" Command="{Binding ExportPhongCommand}" Style="{StaticResource ToolbarButtonStyle}" Height="50"/>
            <Button Content="Xuất phiếu thu bài" Command="{Binding ExportPhieuCommand}" Style="{StaticResource ToolbarButtonStyle}" Height="50"/>
        </StackPanel>
    </Grid>
</UserControl>
