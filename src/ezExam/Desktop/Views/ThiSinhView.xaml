<UserControl x:Class="Desktop.Views.ThiSinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding KyThiMacDinhText}" FontWeight="Bold" FontSize="14" Foreground="DarkBlue" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Chọn file Excel" Command="{Binding ChooseFileCommand}" Width="150"/>
            <TextBlock Text="{Binding SelectedFile}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Sheet:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheet}" Width="180"/>
            <Button Content="Import" Command="{Binding ImportExcelCommand}" Width="90" Margin="8,0,0,0"/>
            <Button Content="Thêm" Command="{Binding AddThiSinhCommand}" Width="80" Margin="8,0,0,0"/>
            <Button Content="Lưu" Command="{Binding SaveAllThiSinhCommand}" Width="80" Margin="8,0,0,0"/>
            <Button Content="Xóa" Command="{Binding DeleteThiSinhCommand}" Width="80" Margin="8,0,0,0"/>
            <Button Content="Xếp ca thi" Command="{Binding AssignCaThiCommand}" Width="110" Margin="8,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding ThiSinhList}" SelectedItem="{Binding SelectedThiSinh}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="SBD" Binding="{Binding SBD, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Lớp" Binding="{Binding Lop, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Các môn thi" Binding="{Binding CacMonThi, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                <DataGridTextColumn Header="Ca 1" Binding="{Binding MonCa1}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ca 2" Binding="{Binding MonCa2}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="4" Header="Thống kê cặp môn tự chọn" Margin="0,10,0,0">
            <DataGrid ItemsSource="{Binding PairStats}" AutoGenerateColumns="False" IsReadOnly="True" Height="140">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Môn A" Binding="{Binding MonA}" Width="120"/>
                    <DataGridTextColumn Header="Môn B" Binding="{Binding MonB}" Width="120"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Count}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
