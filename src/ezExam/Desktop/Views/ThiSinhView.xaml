<UserControl x:Class="Desktop.Views.ThiSinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kỳ thi -->
        <TextBlock Grid.Row="0"
                   Text="{Binding KyThiMacDinhText}"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="DarkBlue"
                   Margin="0,0,0,10"/>

        <!-- Chọn file Excel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Chọn file Excel" Command="{Binding ChooseFileCommand}" Width="150"/>
            <TextBlock Text="{Binding SelectedFile}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Chọn sheet + Import + Xếp ca -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Sheet:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheet}" Width="200"/>
            <Button Content="Import" Command="{Binding ImportExcelCommand}" Width="100" Margin="10,0,0,0"/>
            <Button Content="Xếp ca thi" Command="{Binding AssignCaThiCommand}" Width="120" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Danh sách thí sinh -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding ThiSinhList}"
                  SelectedItem="{Binding SelectedThiSinh}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50"/>
                <DataGridTextColumn Header="SBD" Binding="{Binding SBD}" Width="80"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="150"/>
                <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh}" Width="100"/>
                <DataGridTextColumn Header="Lớp" Binding="{Binding Lop}" Width="80"/>
                <DataGridCheckBoxColumn Header="Ngữ văn" Binding="{Binding MonVan}" Width="80"/>
                <DataGridCheckBoxColumn Header="Toán" Binding="{Binding MonToan}" Width="80"/>
                <DataGridTextColumn Header="Ca 1" Binding="{Binding MonCa1}" Width="120"/>
                <DataGridTextColumn Header="Ca 2" Binding="{Binding MonCa2}" Width="120"/>
                <DataGridTextColumn Header="Các môn thi" Binding="{Binding CacMonThi}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Thống kê cặp môn -->
        <GroupBox Grid.Row="4" Header="Thống kê cặp môn tự chọn" Margin="0,10,0,0">
            <DataGrid ItemsSource="{Binding PairStats}" AutoGenerateColumns="False" IsReadOnly="True" Height="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Môn A" Binding="{Binding MonA}" Width="120"/>
                    <DataGridTextColumn Header="Môn B" Binding="{Binding MonB}" Width="120"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Count}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
