<Application x:Class="ezExam.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ezExam.App.Converters">
    <Application.Resources>

        <!-- Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:RoomTypeToStringConverter x:Key="RoomTypeToString"/>
        <!-- bool → text theo ConverterParameter "TrueText|FalseText" -->
        <conv:BoolToTextConverter x:Key="BoolToText"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- string → Visibility (rỗng = Collapsed) -->
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="Padding"           Value="16 8"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D5166"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A252F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#2980B9"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16 8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Thêm vào Application.Resources trong App.xaml -->

        <DataTemplate x:Key="RoomTabTemplate">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <!-- Danh sách phòng -->
                    <ColumnDefinition Width="12"/>
                    <!-- Khoảng cách -->
                    <ColumnDefinition Width="*"/>
                    <!-- Danh sách TS -->
                </Grid.ColumnDefinitions>

                <!-- DANH SÁCH PHÒNG -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top"
                       Text="Danh sách phòng"
                       FontSize="13" FontWeight="Bold"
                       Margin="0 0 0 8"/>

                    <ListBox ItemsSource="{Binding Tag,
                                   RelativeSource={RelativeSource AncestorType=ContentControl}}"
                     SelectedItem="{Binding SelectedRoom}"
                     BorderBrush="#DDE1E7" BorderThickness="1">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4 6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <!-- Tên phòng -->
                                        <TextBlock Text="{Binding RoomName}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                        <!-- Môn thi trong phòng -->
                                        <TextBlock Text="{Binding SubjectNames}"
                                           FontSize="11" Foreground="#7F8C8D"
                                           TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Số TS -->
                                    <Border Grid.Column="1"
                                    Background="#EBF5FB"
                                    CornerRadius="10" Padding="8 2"
                                    VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Foreground="#2471A3"
                                           FontWeight="Bold">
                                    <Run Text="{Binding Assignments.Count}"/>
                                    <Run Text=" TS"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <!-- Highlight phòng chưa đầy -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6 2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Assignments.Count}"
                                         Value="24">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <!-- DANH SÁCH THÍ SINH TRONG PHÒNG -->
                <DockPanel Grid.Column="2">

                    <!-- Tiêu đề phòng đang chọn -->
                    <Border DockPanel.Dock="Top"
                    Background="#F8F9FA"
                    BorderBrush="#DDE1E7" BorderThickness="1"
                    CornerRadius="4" Padding="10 8"
                    Margin="0 0 0 8">
                        <TextBlock Text="{Binding SelectedRoomTitle}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#2C3E50"/>
                    </Border>

                    <!-- DataGrid thí sinh -->
                    <DataGrid ItemsSource="{Binding RoomCandidates}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="32" FontSize="13"
                      BorderBrush="#DDE1E7" BorderThickness="1"
                      Visibility="{Binding HasSelectedRoom,
                                   Converter={StaticResource BoolToVisibility}}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT"
                                        Binding="{Binding OrderInRoom}"
                                        Width="55"/>
                            <DataGridTextColumn Header="SBD"
                                        Binding="{Binding Candidate.CandidateNumber}"
                                        Width="90"/>
                            <DataGridTextColumn Header="Họ và tên"
                                        Binding="{Binding Candidate.FullName}"
                                        Width="200"/>
                            <DataGridTextColumn Header="Ngày sinh"
                                        Binding="{Binding Candidate.DateOfBirth,
                                                  StringFormat=dd/MM/yyyy}"
                                        Width="100"/>
                            <DataGridTextColumn Header="Lớp"
                                        Binding="{Binding Candidate.ClassName}"
                                        Width="80"/>
                            <DataGridTextColumn Header="Môn thi"
                                        Binding="{Binding SubjectName}"
                                        Width="*"/>
                        </DataGrid.Columns>

                        <!-- Màu xen kẽ dòng -->
                        <DataGrid.AlternatingRowBackground>
                            <SolidColorBrush Color="#F8F9FA"/>
                        </DataGrid.AlternatingRowBackground>
                    </DataGrid>

                    <!-- Placeholder khi chưa chọn phòng -->
                    <Border Visibility="{Binding HasSelectedRoom,
                                 Converter={StaticResource InverseBoolToVisibility}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                        <TextBlock Text="← Chọn phòng thi để xem danh sách thí sinh"
                           FontSize="14" Foreground="#BDC3C7"/>
                    </Border>

                </DockPanel>
            </Grid>
        </DataTemplate>

    </Application.Resources>
</Application>