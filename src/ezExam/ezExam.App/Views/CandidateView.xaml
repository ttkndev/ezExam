<UserControl x:Class="ezExam.App.Views.CandidateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
            <!-- Thống kê nhanh -->
            <RowDefinition Height="*"/>
            <!-- Nội dung tab -->
        </Grid.RowDefinitions>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="0"
                Background="#F8F9FA"
                BorderBrush="#DDE1E7" BorderThickness="1"
                CornerRadius="6" Padding="12 8"
                Margin="0 0 0 10">
            <WrapPanel>

                <Button Content="📂 Import Excel"
                        Command="{Binding ImportCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0 0 8 0"/>

                <Button Content="🔄 Tải lại"
                        Command="{Binding RefreshCommand}"
                        Padding="12 8" FontSize="13"
                        Margin="0 0 16 0"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="0 0 16 0"/>

                <!-- SBD bắt đầu -->
                <TextBlock Text="SBD bắt đầu:"
                           VerticalAlignment="Center"
                           FontSize="13" Margin="0 0 6 0"/>
                <TextBox Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}"
                         Width="70" Padding="6 4" FontSize="13"
                         VerticalContentAlignment="Center"
                         Margin="0 0 8 0"/>

                <TextBlock Text="Format SBD:" VerticalAlignment="Center" FontSize="13" Margin="0 0 6 0"/>
                <TextBox Text="{Binding CandidateNumberFormat, UpdateSourceTrigger=PropertyChanged}"
                         Width="110" Padding="6 4" FontSize="13"
                         VerticalContentAlignment="Center"
                         Margin="0 0 6 0"/>
                <TextBlock Text="→" VerticalAlignment="Center" FontSize="13" Margin="0 0 4 0"/>
                <TextBlock Text="{Binding PreviewStartCandidateNumber}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 10 0"/>

                <Button Content="🔢 Sắp xếp &amp; Đánh SBD"
                        Command="{Binding SortAssignCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0 0 8 0"/>

                <Button Content="📅 Xếp ca thi"
                        Command="{Binding ScheduleShiftCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0 0 8 0"/>

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBusy,
                                         Converter={StaticResource BoolToVisibility}}"
                            VerticalAlignment="Center" Margin="8 0 0 0">
                    <ProgressBar IsIndeterminate="True"
                                 Width="80" Height="6" Margin="0 0 6 0"/>
                    <TextBlock Text="Đang xử lý..."
                               FontSize="12" Foreground="#7F8C8D"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="1"
                Padding="10 6"
                CornerRadius="4"
                Margin="0 0 0 10"
                Visibility="{Binding StatusMessage,
                             Converter={StaticResource StringToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EAFAF1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FDEDEC"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#1E8449"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="#C0392B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ===== TABS ===== -->
        <!-- ===== THỐNG KÊ NHANH ===== -->
        <Border Grid.Row="2" Margin="0 0 0 10" Padding="10" CornerRadius="4" Background="#F8F9FA"
                BorderBrush="#DDE1E7" BorderThickness="1"
                Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Margin="0 0 0 6" FontSize="13">
                    <Run Text="Tổng số thí sinh: "/>
                    <Run Text="{Binding Statistics.TotalCandidates}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Margin="0 0 0 6" FontSize="13" Text="Số lượng đăng ký môn:" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SubjectStatisticTags}" Margin="0 0 0 8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EBF5FB" BorderBrush="#D6EAF8" BorderThickness="1" CornerRadius="10" Padding="8 3" Margin="0 0 6 6">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#1F618D"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0 0 0 6" FontSize="13" Text="Số lượng đăng ký cặp môn tự chọn:" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SubjectPairStatisticTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FDEDEC" BorderBrush="#F5C6CB" BorderThickness="1" CornerRadius="10" Padding="8 3" Margin="0 0 6 6">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#922B21"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding SelectedTab}"
                    BorderThickness="1" BorderBrush="#DDE1E7">

            <!-- TAB 1: DANH SÁCH THÍ SINH -->
            <TabItem Header="👥 Danh sách thí sinh">
                <DataGrid ItemsSource="{Binding Candidates}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="32" FontSize="13"
                          VirtualizingPanel.IsVirtualizing="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SBD"
                                            Binding="{Binding CandidateNumber}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Họ và tên"
                                            Binding="{Binding FullName}"
                                            Width="200"/>
                        <DataGridTextColumn Header="Ngày sinh"
                                            Binding="{Binding DateOfBirth,
                                                      StringFormat=dd/MM/yyyy}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Lớp"
                                            Binding="{Binding ClassName}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Các môn thi"
                                            Binding="{Binding SubjectNames}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Môn ca 1"
                                            Binding="{Binding Shift1SubjectName}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Môn ca 2"
                                            Binding="{Binding Shift2SubjectName}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 2: THỐNG KÊ -->
            <TabItem Header="📊 Thống kê">
                <TextBlock Margin="16" Text="Đã chuyển phần thống kê nhanh lên trên tab Danh sách thí sinh để theo dõi trực tiếp."/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>