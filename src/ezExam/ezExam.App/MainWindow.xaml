<Window x:Class="ezExam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ezExam.App.ViewModels"
        xmlns:views="clr-namespace:ezExam.App.Views"
        Title="{Binding SessionTitle}"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- DataTemplate: ánh xạ ViewModel → View -->
        <DataTemplate DataType="{x:Type vm:ExamSessionViewModel}">
            <views:ExamSessionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CandidateViewModel}">
            <views:CandidateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomViewModel}">
            <views:RoomView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Thanh điều hướng -->
            <RowDefinition Height="*"/>
            <!-- Nội dung chính -->
        </Grid.RowDefinitions>

        <!-- ===== THANH ĐIỀU HƯỚNG ===== -->
        <Border Grid.Row="0" Background="#2C3E50">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0">

                <!-- Logo / Tên app -->
                <TextBlock Text="ezExam" Foreground="White"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0 0 24 0"/>

                <!-- Nav buttons -->
                <Button Content="📋 Kỳ thi"
                        Command="{Binding NavSessionCommand}"
                        Style="{StaticResource NavButtonStyle}"/>

                <Button Content="👥 Thí sinh"
                        Command="{Binding NavCandidateCommand}"
                        Style="{StaticResource NavButtonStyle}"/>

                <Button Content="🏫 Phòng thi"
                        Command="{Binding NavRoomCommand}"
                        Style="{StaticResource NavButtonStyle}"/>

                <!-- Kỳ thi đang chọn -->
                <TextBlock Text="{Binding SessionTitle}"
                           Foreground="#BDC3C7"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="32 0 0 0"/>
            </StackPanel>
        </Border>

        <!-- ===== NỘI DUNG CHÍNH ===== -->
        <Grid Grid.Row="1">
            <!-- ContentControl hiển thị View tương ứng ViewModel -->
            <ContentControl Content="{Binding CurrentView}"/>

            <!-- Loading Overlay -->
            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                  Background="#80000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BusyMessage}"
                               Foreground="White" FontSize="16"
                               HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="8" Margin="0 12 0 0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>